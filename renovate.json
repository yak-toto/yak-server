{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices"
    ],
    "minimumReleaseAge": "5 days",
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "pre-commit": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "automergeType": "pr"
    },
    "packageRules": [
        {
            "matchManagers": [
                "dockerfile"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchManagers": [
                "docker-compose"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchManagers": [
                "pep621"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchManagers": [
                "pre-commit"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchUpdateTypes": [
                "lockFileMaintenance"
            ],
            "minimumReleaseAge": null
        },
        {
            "description": "Postgres major upgrades must be approved and merged manually",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "postgres"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true,
            "automerge": false
        },
        {
            "description": "zizmor-action 'version' input only accepts a plain tag: no digest pinning",
            "matchManagers": [
                "github-actions"
            ],
            "matchDepNames": [
                "ghcr.io/zizmorcore/zizmor"
            ],
            "pinDigests": false
        }
    ]
}
